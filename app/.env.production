# Deploys fetch weights from the Hugging Face CDN, not from the site itself, so
# dist stays small. The v1 segment is part of the cache key: re-quantizing means
# uploading to v2 rather than overwriting, or returning visitors keep stale weights.
VITE_MODELS_BASE=https://huggingface.co/nvkudva/laya-web-q8/resolve/main/v1
